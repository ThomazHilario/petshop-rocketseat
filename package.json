{
  "name": "petshop-monorepo",
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --config=apps/petshop-api/prisma7.config.ts",
    "db:reset": "dotenv -e .env -- prisma migrate reset --config=apps/petshop-api/prisma7.config.ts",
    "db:generate": "dotenv -e .env -- prisma generate --config=apps/petshop-api/prisma7.config.ts"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.10.12"
  }
}
